{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Lecture Platform",
  "version": "0.1.0",
  "identifier": "com.university.lectureplatform",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Lecture Platform",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https:; media-src http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": false
  }
}
