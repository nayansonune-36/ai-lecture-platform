# =============================================================================
# AI Lecture Platform - Environment Configuration
# =============================================================================
# First-time setup on Windows (recommended):
#   powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1
#
# Manual setup:
#   cp .env.example .env
# Never commit .env into source control.
# =============================================================================

# Environment ('development' or 'production')
ENVIRONMENT=development

# =============================================================================
# 1. Host Development Configuration (Default for Windows / local host)
# =============================================================================
# Use these settings when running API, Worker, and Web directly on the host machine
# while Postgres and Redis run inside Docker with ports published to 127.0.0.1.

# --- Caddy Reverse Proxy ---
# In dev, Caddy publishes port 8080 (HTTP) and 8443 (HTTPS) on the host
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- PostgreSQL (with pgvector, pg_trgm, pgcrypto) ---
# Published to 127.0.0.1:5432 from Docker (never exposed to LAN).
POSTGRES_DB=lecture_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@127.0.0.1:5432/lecture_platform

# --- Redis (Job queue with ARQ) ---
# Published to 127.0.0.1:6379 from Docker (never exposed to LAN).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage ---
# STORAGE_ROOT MUST be an absolute path on the host. Relative paths like ./storage
# resolve differently across services (api vs worker vs caddy) and are rejected.
# scripts/setup-dev.ps1 will automatically populate this with your absolute path.
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=8589934592

# --- Auth & Security ---
# Secret key used for JWT access and refresh token signing (min 32 bytes)
# scripts/setup-dev.ps1 generates this automatically.
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# HMAC key used for short-lived signed video/transcript URLs (forward_auth)
# scripts/setup-dev.ps1 generates this automatically.
MEDIA_SIGNING_KEY=change_this_to_a_secure_media_signing_key_in_production
MEDIA_URL_EXPIRE_MINUTES=15

# Ed25519 key used for signing offline lecture licenses (PKCS8 single-line PEM)
# scripts/setup-dev.ps1 generates this automatically.
LICENSE_SIGNING_KEY=""
# Dev-only setting: override license validity period in seconds (e.g. 180 for 3-minute expiry testing)
LICENSE_TTL_SECONDS=1209600

# --- AI Models (Ollama) ---
# Multilingual embedding model (1024 dims)
EMBEDDING_MODEL=bge-m3
# Ollama base URL on host
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Server LLM model
LLM_MODEL=qwen2.5:7b

# --- Media Processing (Worker) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# =============================================================================
# 2. Containerized Deployment Overrides (Docker-internal network)
# =============================================================================
# When running API and Worker inside Docker containers on the "internal" network,
# replace localhost hostnames with Docker service names and use container paths:
#
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/lecture_platform
# REDIS_URL=redis://redis:6379/0
# OLLAMA_BASE_URL=http://ollama:11434
# STORAGE_ROOT=/storage
# =============================================================================
