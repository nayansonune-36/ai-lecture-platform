# =============================================================================
# AI Lecture Platform - Environment Configuration Example
# =============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
# Never commit .env into source control.
# =============================================================================

# Environment ('development' or 'production')
ENVIRONMENT=development

# --- Caddy Reverse Proxy ---
# In dev, Caddy publishes these ports on the host
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- PostgreSQL (with pgvector, pg_trgm, pgcrypto) ---
# Note: In docker-compose, Postgres does NOT publish ports to the host.
# Access is internal to the Docker network via service name "postgres".
POSTGRES_DB=lecture_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@postgres:5432/lecture_platform

# --- Redis (Job queue with ARQ) ---
# Note: Redis does NOT publish ports to the host.
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# Path on host to the storage directory (mounted into Caddy at /storage)
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=8589934592

# --- Auth & Security ---
# Secret key used for JWT access and refresh token signing
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# HMAC key used for short-lived signed video/transcript URLs (forward_auth)
# Generate with: openssl rand -hex 32
MEDIA_SIGNING_KEY=change_this_to_a_secure_media_signing_key_in_production
MEDIA_URL_EXPIRE_MINUTES=15

# Ed25519 key used for signing offline lecture licenses (14-day validity)
# Generate with: uv run python services/api/scripts/generate_license_keys.py
LICENSE_SIGNING_KEY=""

# --- AI Models (Ollama) ---
# Multilingual embedding model (1024 dims)
EMBEDDING_MODEL=bge-m3
# Ollama internal base URL
OLLAMA_BASE_URL=http://ollama:11434

# --- Media Processing (Worker) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Server LLM model
LLM_MODEL=qwen2.5:7b
